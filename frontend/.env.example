# Reservia frontend (Vite) - environment variables
#
# Copy to `.env.local` (or `.env`) in this folder - both are gitignored:
#   PowerShell:  Copy-Item .env.example .env.local
#   CMD:         copy .env.example .env.local
# Vite reads these at dev-server start / build time; restart `npm run dev` after editing.
#
# EVERY variable here is embedded into the browser bundle and visible to anyone - never put a
# secret (database URI, JWT secret, API secret, SMTP password) in this file.
# Production values are set in the frontend's Vercel project, not here.

# REQUIRED - base URL of the backend API, including the /api/v1 prefix, no trailing slash.
# Every request is `${VITE_API_URL}/<path>` (src/utils/helpers/api-request.ts). Locally this must
# point at YOUR local backend (backend/.env PORT, default 5000) - not the deployed one.
VITE_API_URL=http://localhost:5000/api/v1

# REQUIRED for Customization > About only - the _id of the single "About" document (logo and
# barcode-sticker settings). Not a secret. A fresh local database has no About document yet;
# the rest of the app works without it. Copy the _id from your database's
# `aboutusandsubcategories` collection (the same document GET /api/v1/about-us returns).
VITE_ABOUT_ID=

# OPTIONAL - Google OAuth *client ID* for the "Sign in with Google" button (public by design; a
# client secret would never go here). Email/password login works without it.
VITE_GOOGLE_CLIENT_ID=

# OPTIONAL - table page sizes (default 25 each when unset).
# VITE_ITEMS_PER_PAGE=25
# VITE_PRODUCTS_PER_PAGE=25
# VITE_VENDORS_PER_PAGE=25
# VITE_CUSTOMERS_PER_PAGE=25
# VITE_PURCHASE_ORDERS_PER_PAGE=25
# VITE_SALES_ORDERS_PER_PAGE=25
# VITE_EXPENSES_PER_PAGE=25
# VITE_TRANSFERS_PER_PAGE=25
# VITE_COUPONS_PER_PAGE=25
# VITE_PAYMENTS_PER_PAGE=25
# VITE_TRANSACTIONS_PER_PAGE=25
# VITE_USERS_PER_PAGE=25
