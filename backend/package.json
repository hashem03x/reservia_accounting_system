{
  "name": "reversia-accounting-backend",
  "version": "1.0.0",
  "description": "Backend API for the Reversia Accounting System",
  "type": "commonjs",
  "main": "api/index.js",
  "scripts": {
    "test": "node --test server/test/**/*.test.js",
    "db:init": "node server/scripts/initDb.js",
    "db:reset": "node server/scripts/resetDb.js",
    "db:seed-accounts": "node server/scripts/seedChartOfAccounts.js",
    "db:migrate-project-fields": "node server/scripts/migrateProjectFieldRenames.js",
    "db:migrate-variants-to-products": "node server/scripts/migrateVariantsToProducts.js",
    "db:create-admin": "node server/scripts/createAdminUser.js",
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "staging": "cross-env NODE_ENV=staging nodemon server.js",
    "prod": "cross-env NODE_ENV=production node server.js",
    "pm2:start": "cross-env NODE_ENV=production pm2 start server.js --name reversia-accounting",
    "pm2:stop": "pm2 stop reversia-accounting",
    "pm2:restart": "pm2 restart reversia-accounting",
    "pm2:reload": "pm2 reload reversia-accounting",
    "pm2:delete": "pm2 delete reversia-accounting",
    "pm2:logs": "pm2 logs reversia-accounting",
    "pm2:logs:follow": "pm2 logs reversia-accounting --follow",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",
    "pm2:resurrect": "pm2 resurrect",
    "pm2:startup": "pm2 startup",
    "pm2:unstartup": "pm2 unstartup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "cloudinary": "^1.41.3",
    "color": "^4.2.3",
    "colors": "^1.4.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.15.0",
    "fast-csv": "^5.0.2",
    "helmet": "^6.1.5",
    "i18next": "^23.12.2",
    "i18next-fs-backend": "^2.3.2",
    "i18next-http-middleware": "^3.6.0",
    "jsbarcode": "^3.11.6",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "kleur": "^4.1.5",
    "mongodb": "^6.13.0",
    "mongoose": "^7.8.3",
    "mongoose-i18n-localize": "^0.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.1",
    "sharp": "^0.33.5",
    "slugify": "^1.6.5",
    "swagger-ui-express": "^5.0.0",
    "tar": "^7.5.15",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.37.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.7"
  },
  "engines": {
    "node": "24.x"
  }
}
