# Reservia backend - environment variables (local development template)
#
# Copy this file to `config.env` in this folder (the documented convention) and fill in the values:
#   PowerShell:  Copy-Item .env.example config.env
#   CMD:         copy .env.example config.env
# A plain `.env` in this folder also works for the server and every `npm run db:*` script
# (server/config/env.js loads config.env first, then .env, and .env wins on conflicts). A few
# legacy one-off maintenance scripts (server/scripts/import*.js, update*.js) only read config.env,
# so config.env is the safer choice. Both files are gitignored - never commit real values.
#
# Production (Vercel) never reads this file or config.env - production values live in the Vercel
# project's Environment Variables. Placeholders only below; no real credentials.

# =====================================================================================
# Core - REQUIRED
# =====================================================================================
# `development` locally. Affects cookie flags (server/utils/cookieOptions.js), error output
# (errorMiddleware.js) and blocks nothing else; `npm run db:reset` refuses to run when "production".
NODE_ENV=development
# Port the local server listens on (server.js). Default if unset: 5000.
PORT=5000
# MongoDB connection string - the ONLY database setting the app uses (server/database/dbConnection.js
# and every npm run db:* script). The server exits at startup if it is missing or unreachable.
# Always include an explicit database name in the path, otherwise the driver silently uses "test".
#   Local MongoDB:   mongodb://127.0.0.1:27017/reversia-accounting
#   MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster-host>/reversia-accounting?retryWrites=true&w=majority
# Note: Sales/Purchase Order creation, Payments and journal reversals use MongoDB transactions, which
# require a replica set (Atlas always is; a plain local `mongod` must be started as a single-node
# replica set - see docs/LOCAL_DEVELOPMENT.md).
DB_URI=mongodb://127.0.0.1:27017/reversia-accounting

# Signs access-token / refresh-token JWTs (server/utils/createToken.js, authController.js).
# Login fails with an error if these are empty. Use any long random string locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace_with_a_long_random_local_secret
REFRESH_TOKEN_SECRET_KEY=replace_with_a_different_long_random_local_secret
# Token lifetimes (jsonwebtoken `expiresIn` format).
JWT_EXPIRES_IN=90d
REFRESH_TOKEN_EXPIRES_IN=180d

# =====================================================================================
# URLs
# =====================================================================================
# This backend's own public base URL - used to build absolute image URLs for brand/category/
# subcategory/warehouse/about images served from /uploads. Locally: the backend itself.
BASE_URL=http://localhost:5000
# Same purpose for product images (productController.js picks DEV_URL when NODE_ENV=development,
# PROD_URL otherwise). Must point at the BACKEND (which serves /products/... from uploads/), not
# at the frontend.
DEV_URL=http://localhost:5000
PROD_URL=

# CORS: the exact deployed frontend origin (no trailing slash) allowed to make credentialed
# requests. OPTIONAL locally - http://localhost:5173, http://127.0.0.1:5173 and
# http://localhost:3000 are always allowed (server/app.js). Required in production (Vercel), e.g.
# https://reserviafrontend.vercel.app - set it there, not here.
FRONTEND_URL=

# =====================================================================================
# i18n - OPTIONAL
# =====================================================================================
DEFAULT_LANGUAGE=en
DEFAULT_LOCALE=en

# =====================================================================================
# Image / document uploads (Cloudinary) - OPTIONAL locally
# =====================================================================================
# Needed only for features that upload to Cloudinary (vendor/customer business documents, project
# contract PDFs, Cloudinary-backed images). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# The server starts fine without it; those uploads fail until it is set.
CLOUDINARY_URL=
# Output quality (1-100) for locally processed images.
IMAGE_QUALITY=80

# =====================================================================================
# Outbound email (SMTP) - OPTIONAL locally
# =====================================================================================
# Needed only for password-reset codes (utils/sendEmail.js) and backup-failure alerts
# (backup/backup.notifier.js). Port 465 = implicit TLS; any other port = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_NAME=Reservia

# =====================================================================================
# Document numbering - OPTIONAL (seed values only)
# =====================================================================================
# Only used the FIRST time the matching counter document is created in the `counters` collection;
# after that the stored counter is authoritative. Vendor numbers are NOT configurable - they are
# issued from 2000 upwards (2000-2999), see server/services/vendor/vendorNumberService.js.
CUSTOMER_NUMBER_RANGE_START=1000
CUSTOMER_NUMBER_RANGE_END=999999
JOURNAL_ENTRY_NUMBER_RANGE_START=100000
JOURNAL_ENTRY_NUMBER_RANGE_END=999999999

# =====================================================================================
# Legacy default account codes - OPTIONAL (leave unset)
# =====================================================================================
# Lookup codes for the legacy fixed-asset/project-creation entries (utils/accountingConstants.js
# DefaultAccountCodes). Defaults: 1100, 2400, 1000, 4000, 1500, 2000, 3000. Override only if your
# Chart of Accounts uses different codes. (The automatic accounting engine uses its own fixed codes.)
# ACCOUNT_CODE_ACCOUNTS_RECEIVABLE=1100
# ACCOUNT_CODE_UNEARNED_REVENUE=2400
# ACCOUNT_CODE_CASH=1000
# ACCOUNT_CODE_PROJECT_REVENUE=4000
# ACCOUNT_CODE_FIXED_ASSETS=1500
# ACCOUNT_CODE_ACCOUNTS_PAYABLE=2000
# ACCOUNT_CODE_CAPITAL=3000

# Sales Order Cost Recognition accounts (Dr COGS / Cr this account) - OPTIONAL. Defaults are
# 50000001 (Raw Materials) and 11000007 (Materials Inventory), pending accounting confirmation.
# COST_RECOGNITION_COGS_ACCOUNT_CODE=50000001
# COST_RECOGNITION_CREDIT_ACCOUNT_CODE=11000007

# =====================================================================================
# Secondary database health check - OPTIONAL
# =====================================================================================
# Connection string pinged ONLY by GET /api/v1/bahrain-db-health (server/routes/databaseHealth.js).
# Unrelated to DB_URI; leave empty locally (the route then just reports "disconnected").
# (Earlier docs called this `Bahrain_DB` - the code actually reads DB_URL.)
DB_URL=

# =====================================================================================
# Tests - OPTIONAL
# =====================================================================================
# Leave UNSET: `npm test` then gives each test file its own throw-away local database
# (mongodb://127.0.0.1:27017/reversia_test_<name>), which the test DROPS. Setting it makes every test
# file share (and drop) one database. Never point it at a real database.
# TEST_DB_URI=

# VERCEL is set automatically by the Vercel platform - never set it locally.
