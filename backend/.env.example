# Image / document uploads (Cloudinary) - OPTIONAL locally
# =====================================================================================
# Needed only for features that upload to Cloudinary (vendor/customer business documents, project
# contract PDFs, Cloudinary-backed images). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# The server starts fine without it; those uploads fail until it is set.
CLOUDINARY_URL=
# Output quality (1-100) for locally processed images.
IMAGE_QUALITY=80

# =====================================================================================
# Outbound email (SMTP) - OPTIONAL locally
# =====================================================================================
# Needed only for password-reset codes (utils/sendEmail.js) and backup-failure alerts
# (backup/backup.notifier.js). Port 465 = implicit TLS; any other port = STARTTLS.
=======
# Image uploads (admin product/category/brand/vendor images)
# =====================================================================================
CLOUDINARY_URL=
IMAGE_QUALITY=80

# =====================================================================================
# Customer numbering (see server/services/customer/customerNumberService.js)
# =====================================================================================
# Inclusive range customer numbers are atomically allocated from. Only used to SEED the
# `counters` collection the first time a customer is ever created - after that, the live range is
# whatever is stored on that document (an admin can widen it later by editing the document
# directly, without needing to change these env vars or redeploy).
CUSTOMER_NUMBER_RANGE_START=1000
CUSTOMER_NUMBER_RANGE_END=999999

