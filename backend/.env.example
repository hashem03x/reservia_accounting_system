# Reservia backend - environment variables (local development template)
#
# Copy this file to `config.env` in this folder (the documented convention) and fill in the values:
#   PowerShell:  Copy-Item .env.example config.env
#   CMD:         copy .env.example config.env
# A plain `.env` in this folder also works for the server and every `npm run db:*` script
# (server/config/env.js loads config.env first, then .env, and .env wins on conflicts). A few
# legacy one-off maintenance scripts (server/scripts/import*.js, update*.js) only read config.env,
# so config.env is the safer choice. Both files are gitignored - never commit real values.
#
# Production (Vercel) never reads this file or config.env - production values live in the Vercel
# project's Environment Variables. Placeholders only below; no real credentials.

# =====================================================================================
# Core - REQUIRED
# =====================================================================================
# `development` locally. Affects cookie flags (server/utils/cookieOptions.js), error output
# (errorMiddleware.js) and blocks nothing else; `npm run db:reset` refuses to run when "production".
NODE_ENV=development
# Port the local server listens on (server.js). Default if unset: 5000.
PORT=5000
# MongoDB connection string - the ONLY database setting the app uses (server/database/dbConnection.js
# and every npm run db:* script). The server exits at startup if it is missing or unreachable.
# Always include an explicit database name in the path, otherwise the driver silently uses "test".
#   Local MongoDB:   mongodb://127.0.0.1:27017/reversia-accounting
#   MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster-host>/reversia-accounting?retryWrites=true&w=majority
# Note: Sales/Purchase Order creation, Payments and journal reversals use MongoDB transactions, which
# require a replica set (Atlas always is; a plain local `mongod` must be started as a single-node
# replica set - see docs/LOCAL_DEVELOPMENT.md).
DB_URI=mongodb://127.0.0.1:27017/reversia-accounting

# Signs access-token / refresh-token JWTs (server/utils/createToken.js, authController.js).
# Login fails with an error if these are empty. Use any long random string locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace_with_a_long_random_local_secret
REFRESH_TOKEN_SECRET_KEY=replace_with_a_different_long_random_local_secret
# Token lifetimes (jsonwebtoken `expiresIn` format).
JWT_EXPIRES_IN=90d
REFRESH_TOKEN_EXPIRES_IN=180d

# =====================================================================================
# URLs
# =====================================================================================
# This backend's own public base URL - used to build absolute image URLs for brand/category/
# subcategory/warehouse/about images served from /uploads. Locally: the backend itself.
BASE_URL=http://localhost:5000
# Same purpose for product images (productController.js picks DEV_URL when NODE_ENV=development,
# PROD_URL otherwise). Must point at the BACKEND (which serves /products/... from uploads/), not
# at the frontend.
DEV_URL=http://localhost:5000
PROD_URL=

# CORS: the exact deployed frontend origin (no trailing slash) allowed to make credentialed
# requests. OPTIONAL locally - http://localhost:5173, http://127.0.0.1:5173 and
# http://localhost:3000 are always allowed (server/app.js). Required in production (Vercel), e.g.
# https://reserviafrontend.vercel.app - set it there, not here.
FRONTEND_URL=

# =====================================================================================
# i18n - OPTIONAL
# =====================================================================================
=======
# Reversia Accounting Backend - environment variables
# Copy to config.env and fill in real values. config.env is gitignored - never commit real secrets.

# =====================================================================================
# Core / required
# =====================================================================================
NODE_ENV=development
PORT=5000
# MongoDB connection string. Include an explicit database name in the path
# (mongodb+srv://user:pass@cluster.mongodb.net/reversia-accounting?...) - if omitted, the driver
# silently defaults to a database named "test", which is almost never what you want.
DB_URI=mongodb://localhost:27017/reversia-accounting
# Base URL this server is reachable at (used to build absolute asset URLs, e.g. brand/category images)
BASE_URL=http://localhost:5000

# The deployed frontend's exact origin (no trailing slash) - the one production origin CORS allows
# for cross-origin, credentialed (cookie-based) requests. Local dev origins (localhost:5173,
# localhost:3000) are always allowed unconditionally, in addition to this. See server/app.js.
# Must be set in the Vercel project's own Environment Variables for production - this file/
# config.env/.env are never read by a Vercel deployment, only by a locally-run server.
FRONTEND_URL=https://reserviafrontend.vercel.app

# Auth
JWT_SECRET_KEY=
JWT_EXPIRES_IN=90d
REFRESH_TOKEN_SECRET_KEY=
REFRESH_TOKEN_EXPIRES_IN=180d

