SMTP_NAME=Reservia

# =====================================================================================
# Document numbering - OPTIONAL (seed values only)
# =====================================================================================
# Only used the FIRST time the matching counter document is created in the `counters` collection;
# after that the stored counter is authoritative. Vendor numbers are NOT configurable - they are
# always 2xxxx (20001-29999), see server/services/vendor/vendorNumberService.js.
CUSTOMER_NUMBER_RANGE_START=1000
CUSTOMER_NUMBER_RANGE_END=999999
JOURNAL_ENTRY_NUMBER_RANGE_START=100000
JOURNAL_ENTRY_NUMBER_RANGE_END=999999999

# =====================================================================================
# Legacy default account codes - OPTIONAL (leave unset)
# =====================================================================================
# Lookup codes for the legacy fixed-asset/project-creation entries (utils/accountingConstants.js
# DefaultAccountCodes). Defaults: 1100, 2400, 1000, 4000, 1500, 2000, 3000. Override only if your
# Chart of Accounts uses different codes. (The automatic accounting engine uses its own fixed codes.)
# ACCOUNT_CODE_ACCOUNTS_RECEIVABLE=1100
# ACCOUNT_CODE_UNEARNED_REVENUE=2400
# ACCOUNT_CODE_CASH=1000
# ACCOUNT_CODE_PROJECT_REVENUE=4000
# ACCOUNT_CODE_FIXED_ASSETS=1500
# ACCOUNT_CODE_ACCOUNTS_PAYABLE=2000
# ACCOUNT_CODE_CAPITAL=3000

# =====================================================================================
# Secondary database health check - OPTIONAL
# =====================================================================================
# Connection string pinged ONLY by GET /api/v1/bahrain-db-health (server/routes/databaseHealth.js).
# Unrelated to DB_URI; leave empty locally (the route then just reports "disconnected").
# (Earlier docs called this `Bahrain_DB` - the code actually reads DB_URL.)
DB_URL=

# =====================================================================================
# Tests - OPTIONAL
# =====================================================================================
# Leave UNSET: `npm test` then gives each test file its own throw-away local database
# (mongodb://127.0.0.1:27017/reversia_test_<name>), which the test DROPS. Setting it makes every test
# file share (and drop) one database. Never point it at a real database.
# TEST_DB_URI=

# VERCEL is set automatically by the Vercel platform - never set it locally.
=======
SMTP_NAME=Reversia

# =====================================================================================
# Misc
# =====================================================================================
# Used by a couple of dev/staging redirect helpers
DEV_URL=http://localhost:5173
PROD_URL=

# Optional secondary MongoDB connection string, only read by the GET /api/v1/bahrain-db-health
# ping endpoint (server/routes/databaseHealth.js) - unrelated to the main DB_URI connection above.
# NOTE: the code reads this exact (unconventionally-cased) name - do not rename to DB_URL/DB_URI,
# that would silently stop the health check from picking it up.
Bahrain_DB=
