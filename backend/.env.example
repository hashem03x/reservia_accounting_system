# Reversia Accounting Backend - environment variables
# Copy to config.env and fill in real values. config.env is gitignored - never commit real secrets.

# =====================================================================================
# Core / required
# =====================================================================================
NODE_ENV=development
PORT=5000
# MongoDB connection string. Include an explicit database name in the path
# (mongodb+srv://user:pass@cluster.mongodb.net/reversia-accounting?...) - if omitted, the driver
# silently defaults to a database named "test", which is almost never what you want.
DB_URI=mongodb://localhost:27017/reversia-accounting
# Base URL this server is reachable at (used to build absolute asset URLs, e.g. brand/category images)
BASE_URL=http://localhost:5000

# The deployed frontend's exact origin (no trailing slash) - the one production origin CORS allows
# for cross-origin, credentialed (cookie-based) requests. Local dev origins (localhost:5173,
# localhost:3000) are always allowed unconditionally, in addition to this. See server/app.js.
# Must be set in the Vercel project's own Environment Variables for production - this file/
# config.env/.env are never read by a Vercel deployment, only by a locally-run server.
FRONTEND_URL=https://reserviafrontend.vercel.app

# Auth
JWT_SECRET_KEY=
JWT_EXPIRES_IN=90d
REFRESH_TOKEN_SECRET_KEY=
REFRESH_TOKEN_EXPIRES_IN=180d

# i18n
DEFAULT_LANGUAGE=en
DEFAULT_LOCALE=en

# =====================================================================================
# Image uploads (admin product/category/brand/vendor images)
# =====================================================================================
CLOUDINARY_URL=
IMAGE_QUALITY=80

# =====================================================================================
# Customer numbering (see server/services/customer/customerNumberService.js)
# =====================================================================================
# Inclusive range customer numbers are atomically allocated from. Only used to SEED the
# `counters` collection the first time a customer is ever created - after that, the live range is
# whatever is stored on that document (an admin can widen it later by editing the document
# directly, without needing to change these env vars or redeploy).
CUSTOMER_NUMBER_RANGE_START=1000
CUSTOMER_NUMBER_RANGE_END=999999

# =====================================================================================
# Outbound email (password reset codes, backup failure alerts)
# =====================================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_NAME=Reversia

# =====================================================================================
# Misc
# =====================================================================================
# Used by a couple of dev/staging redirect helpers
DEV_URL=http://localhost:5173
PROD_URL=

# Optional secondary MongoDB connection string, only read by the GET /api/v1/bahrain-db-health
# ping endpoint (server/routes/databaseHealth.js) - unrelated to the main DB_URI connection above.
# NOTE: the code reads this exact (unconventionally-cased) name - do not rename to DB_URL/DB_URI,
# that would silently stop the health check from picking it up.
Bahrain_DB=
